@bot.message_handler(func=lambda message: True)
def handle_text_messages(message: types.Message):
    user = message.from_user
    text = message.text.strip()
    session = get_user_session(user.id)

    # 📌 ধাপ ১: টাকার পরিমাণ ইনপুট
    if session and session.get("step") == "WAIT_AMOUNT":
        try:
            amount_val = float(text)
            if amount_val <= 0:
                raise ValueError()
        except ValueError:
            err_msg = (
                "❌ <b>ভুল ইনপুট!</b>\n\n"
                "অনুগ্রহ করে টাকার পরিমাণটি শুধুমাত্র সংখ্যায় লিখে পাঠান (যেমন: <code>100</code>, <code>500</code>):"
            )
            bot.send_message(message.chat.id, err_msg)
            return

        method = session.get("method", "পেমেন্ট")
        set_user_session(user.id, {
            "step": "WAIT_TRXID",
            "method": method,
            "amount": amount_val
        })

        prompt = (
            f"<b>╭━━━ 💳 {method} পেমেন্ট নির্দেশিকা ━━━╮</b>\n\n"
            f"💰 <b>পাঠানোর পরিমাণ:</b> <code>৳ {amount_val:.2f}</code>\n"
            f"📱 <b>{method} Personal Number:</b> <code>{PAYMENT_NUMBER}</code>\n\n"
            "━━━━━━━━━━━━━━━━━━━━\n"
            "📌 <b>টাকা পাঠানোর নিয়ম:</b>\n"
            f"১. উপরের <code>{PAYMENT_NUMBER}</code> নম্বরে <b>Send Money (সেন্ড মানি)</b> করুন।\n"
            "২. টাকা পাঠানোর পর প্রাপ্ত <b>TrxID (ট্রানজেকশন আইডি)</b> টি নিচে লিখে সেন্ড করুন।\n"
            "━━━━━━━━━━━━━━━━━━━━\n\n"
            "👇 <b>এখন নিচে আপনার TrxID টি টাইপ করে পাঠান:</b>"
        )
        bot.send_message(message.chat.id, prompt)
        return

    # 📌 ধাপ ২: TrxID ইনপুট
    elif session and session.get("step") == "WAIT_TRXID":
        trx_id = text
        amount = session.get("amount", 0.0)
        method = session.get("method", "পেমেন্ট")
        clear_user_session(user.id)

        req_id = f"r_{int(time.time())}_{user.id}"

        db = load_data()
        db["pending"][req_id] = {
            "user_id": user.id,
            "user_name": user.first_name,
            "username": user.username or "No Username",
            "amount": amount,
            "trx_id": trx_id,
            "method": method
        }
        save_data(db)

        # এডমিন ইনবক্সে বার্তা ও বাটন প্রেরণ
        admin_markup = types.InlineKeyboardMarkup(row_width=2)
        btn_app = types.InlineKeyboardButton("✅ এপ্রুভ করুন", callback_data=f"app_{req_id}")
        btn_rej = types.InlineKeyboardButton("❌ বাতিল করুন", callback_data=f"rej_{req_id}")
        admin_markup.add(btn_app, btn_rej)

        username_str = f"@{user.username}" if user.username else "No Username"
        admin_msg = (
            "🔔 <b>নতুন পেমেন্ট ডিপোজিট রিকোয়েস্ট!</b>\n\n"
            f"👤 <b>প্রেরক:</b> {html.escape(user.first_name)} ({html.escape(username_str)})\n"
            f"🆔 <b>ইউজার ID:</b> <code>{user.id}</code>\n"
            f"📱 <b>মেথড:</b> {method}\n"
            f"💵 <b>টাকার পরিমাণ:</b> <code>৳ {amount:.2f}</code>\n"
            f"📝 <b>TrxID:</b> <code>{html.escape(trx_id)}</code>\n\n"
            "👇 <b>ভেরিফাই করে নিচের যেকোনো বাটনে ক্লিক করুন:</b>"
        )

        try:
            bot.send_message(ADMIN_CHAT_ID, admin_msg, reply_markup=admin_markup)
            logging.info(f"Admin notified for req: {req_id}")
        except Exception as e:
            logging.error(f"Failed to notify admin: {e}")

        markup_main = types.InlineKeyboardMarkup()
        markup_main.add(types.InlineKeyboardButton("🔙 প্রধান মেনু", callback_data="menu_main"))

        conf_txt = (
            "🎉 <b>আপনার ডিপোজিট তথ্য সফলভাবে জমা হয়েছে!</b>\n\n"
            f"• <b>পেমেন্ট মেথড:</b> {method}\n"
            f"• <b>টাকার পরিমাণ:</b> ৳ {amount:.2f}\n"
            f"• <b>TrxID:</b> <code>{html.escape(trx_id)}</code>\n\n"
            "⏰ এডমিন ভেরিফাই করে খুব দ্রুত আপনার ওয়ালেটে ব্যালেন্স যুক্ত করে দেবে।"
        )
        bot.send_message(message.chat.id, conf_txt, reply_markup=markup_main)
        return

    else:
        bot.send_message(
            message.chat.id,
            get_main_menu_text(user.first_name, user.id),
            reply_markup=get_main_menu_keyboard()
        )

