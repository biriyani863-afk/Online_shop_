@bot.message_handler(commands=['addbal'])
def handle_addbal(message: types.Message):
    """ এডমিন ম্যানুয়াল ব্যালেন্স অ্যাড: /addbal <user_id> <amount> """
    if message.from_user.id != ADMIN_CHAT_ID:
        return
    
    try:
        parts = message.text.split()
        if len(parts) < 3:
            bot.reply_to(message, "❌ নিয়ম: <code>/addbal <user_id> <amount></code>")
            return
        
        target_id = int(parts[1])
        amount = float(parts[2])

        new_bal = update_user_balance(target_id, amount)
        bot.reply_to(message, f"✅ ইউজার <code>{target_id}</code>-এ ৳{amount:.2f} যোগ করা হয়েছে। নতুন ব্যালেন্স: ৳{new_bal:.2f}")
        
        try:
            bot.send_message(target_id, f"🎉 <b>এডমিন আপনার ওয়ালেটে ৳{amount:.2f} যোগ করেছেন!</b>\nবর্তমান ব্যালেন্স: <b>৳{new_bal:.2f}</b>")
        except Exception as e:
            logging.error(f"User notify error: {e}")
    except Exception as e:
        bot.reply_to(message, f"❌ ইনপুট এরর: {e}")

