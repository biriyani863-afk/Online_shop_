def load_data() -> dict:
    """ ফাইল থেকে ইউজার ডাটা ও সেশন লোড করে """
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                content = f.read().strip()
                if content:
                    data = json.loads(content)
                    data.setdefault("users", {})
                    data.setdefault("pending", {})
                    data.setdefault("sessions", {})
                    return data
        except Exception as e:
            logging.error(f"Data load error: {e}")
    return {"users": {}, "pending": {}, "sessions": {}}

def save_data(data: dict) -> None:
    """ ডাটা ফাইলে সেভ করে """
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        logging.error(f"Data save error: {e}")

def get_user_session(user_id: int) -> dict:
    db = load_data()
    return db.get("sessions", {}).get(str(user_id), {})

def set_user_session(user_id: int, session_data: dict) -> None:
    db = load_data()
    db["sessions"][str(user_id)] = session_data
    save_data(db)

def clear_user_session(user_id: int) -> None:
    db = load_data()
    if str(user_id) in db.get("sessions", {}):
        del db["sessions"][str(user_id)]
        save_data(db)

def get_user_balance(user_id: int) -> float:
    db = load_data()
    return float(db.get("users", {}).get(str(user_id), {}).get("balance", 0.0))

def update_user_balance(user_id: int, amount_change: float) -> float:
    db = load_data()
    u_str = str(user_id)
    if u_str not in db["users"]:
        db["users"][u_str] = {"balance": 0.0}
    
    curr = float(db["users"][u_str].get("balance", 0.0))
    new_bal = curr + amount_change
    db["users"][u_str]["balance"] = new_bal
    save_data(db)
    return new_bal

